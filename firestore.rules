rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && me().get('role', '') == 'admin'; }
    function scoreOk(f, lower, maxV) { let n = request.resource.data; let o = resource.data; return !(f in n) || (n[f] is number && n[f] > 0 && n[f] <= maxV && (!(f in o) || n[f] == o[f] || (lower ? n[f] < o[f] : n[f] > o[f]))); }
    function cntOk(f) { let n = request.resource.data; let o = resource.data; return !(f in n) || (n[f] is int && (n[f] == o.get(f, 0) + 1 || n[f] == o.get(f, 0))); }
    function tsOk(f) { return !(f in request.resource.data) || request.resource.data[f] is number; }
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid && request.resource.data.keys().hasOnly(['name', 'rank', 'nick', 'createdAt']) && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 20 && request.resource.data.rank is string && request.resource.data.rank.size() <= 24 && request.resource.data.nick == request.auth.token.email.split('@')[0] && request.resource.data.createdAt is number;
      allow update: if signedIn() && request.auth.uid == uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rank', 'harcBest', 'harcAt', 'droneBest', 'droneAt', 'gtBest', 'gtBestAt', 'gkBest', 'gkBestAt', 'rkBest', 'rkBestAt', 'rkhBest', 'rkhBestAt', 'harcN', 'droneN', 'gtN', 'gkN', 'rkN', 'lastPlay']) && request.resource.data.get('rank', '') is string && request.resource.data.get('rank', '').size() <= 24 && scoreOk('harcBest', false, 100000) && scoreOk('droneBest', false, 100000000) && scoreOk('gtBest', true, 3600000) && scoreOk('gkBest', false, 100000000) && scoreOk('rkBest', false, 100000) && scoreOk('rkhBest', false, 100000000) && tsOk('rkhBestAt') && tsOk('harcAt') && tsOk('droneAt') && tsOk('gtBestAt') && tsOk('gkBestAt') && tsOk('rkBestAt') && tsOk('lastPlay') && cntOk('harcN') && cntOk('droneN') && cntOk('gtN') && cntOk('gkN') && cntOk('rkN');
      allow update, delete: if isAdmin();
    }
    match /chat/{msgId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['uid', 'name', 'rank', 'text', 'ts']) && request.resource.data.uid == request.auth.uid && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 300 && request.resource.data.name == me().name && request.resource.data.rank == me().get('rank', '') && request.resource.data.ts is number && request.resource.data.ts <= request.time.toMillis() + 60000 && request.resource.data.ts > request.time.toMillis() - 86400000;
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
    }
    match /{document=**} { allow read, write: if false; }
  }
}
