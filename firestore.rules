rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && me().get('role', '') == 'admin'; }
    // Csak a ténylegesen változó mezőket ellenőrizzük. Így egy régi, hibás mező a dokumentumban nem blokkolja a többi írást.
    function chg(f) { return f in request.resource.data && (!(f in resource.data) || request.resource.data[f] != resource.data[f]); }
    function scoreOk(f, lower, maxV) { let n = request.resource.data; let o = resource.data; return !chg(f) || (n[f] is number && n[f] > 0 && n[f] <= maxV && (!(f in o) || n[f] == o[f] || (lower ? n[f] < o[f] : n[f] > o[f]))); }
    function cntOk(f) { let n = request.resource.data; let o = resource.data; return !chg(f) || (n[f] is int && (n[f] == o.get(f, 0) + 1 || n[f] == o.get(f, 0))); }
    function tkOk() { let n = request.resource.data; let o = resource.data; return (!chg('tkGive') || (n.tkGive is number && n.tkGive >= 0 && n.tkGive >= o.get('tkGive', 0))) && (!chg('tkFt') || (n.tkFt is number && n.tkFt >= 0 && n.tkFt >= o.get('tkFt', 0))) && (!chg('tkUteg') || n.tkUteg in ['1. üteg', '2. üteg', '3. üteg', 'Kiképző üteg', 'Törzsüteg', 'Felderítő', 'Szakjavító']) && (!chg('tkWk') || (n.tkWk is string && n.tkWk.size() <= 10)) && (!chg('tkWg') || (n.tkWg is number && n.tkWg >= 0 && (n.get('tkWk', '') != o.get('tkWk', '') || n.tkWg >= o.get('tkWg', 0)))); }
    function tsOk(f) { return !chg(f) || request.resource.data[f] is number; }
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid && request.resource.data.keys().hasOnly(['name', 'rank', 'nick', 'createdAt']) && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 20 && request.resource.data.rank is string && request.resource.data.rank.size() <= 24 && request.resource.data.nick == request.auth.token.email.split('@')[0] && request.resource.data.createdAt is number;
      allow update: if signedIn() && request.auth.uid == uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rank', 'harcBest', 'harcAt', 'droneBest', 'droneAt', 'gtBest', 'gtBestAt', 'gkBest', 'gkBestAt', 'rkBest', 'rkBestAt', 'rkhBest', 'rkhBestAt', 'sereBest', 'sereBestAt', 'harcN', 'droneN', 'gtN', 'gkN', 'rkN', 'sereN', 'tkN', 'tkGive', 'tkUteg', 'tkAt', 'tkOwn', 'tkFt', 'tkOwnF', 'tkWk', 'tkWg', 'lastPlay']) && request.resource.data.get('rank', '') is string && request.resource.data.get('rank', '').size() <= 24 && scoreOk('harcBest', false, 100000) && scoreOk('droneBest', false, 100000000) && scoreOk('gtBest', true, 3600000) && scoreOk('gkBest', false, 100000000) && scoreOk('rkBest', false, 100000) && scoreOk('rkhBest', false, 1000000000000) && tsOk('rkhBestAt') && scoreOk('sereBest', false, 10000000000) && tsOk('sereBestAt') && tsOk('harcAt') && tsOk('droneAt') && tsOk('gtBestAt') && tsOk('gkBestAt') && tsOk('rkBestAt') && tsOk('lastPlay') && cntOk('harcN') && cntOk('droneN') && cntOk('gtN') && cntOk('gkN') && cntOk('rkN') && cntOk('sereN') && cntOk('tkN') && tkOk() && tsOk('tkAt') && (!chg('tkOwn') || (request.resource.data.tkOwn is map && request.resource.data.tkOwn.size() <= 40)) && (!chg('tkOwnF') || (request.resource.data.tkOwnF is map && request.resource.data.tkOwnF.size() <= 40));
      allow update, delete: if isAdmin();
    }
    match /chat/{msgId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['uid', 'name', 'rank', 'text', 'ts']) && request.resource.data.uid == request.auth.uid && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 300 && request.resource.data.name == me().name && request.resource.data.rank == me().get('rank', '') && request.resource.data.ts is number && request.resource.data.ts <= request.time.toMillis() + 60000 && request.resource.data.ts > request.time.toMillis() - 86400000;
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
    }
    match /{document=**} { allow read, write: if false; }
  }
}
