rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && me().get('role', '') == 'admin'; }
    // Csak a ténylegesen változó mezőket ellenőrizzük. Így egy régi, hibás mező a dokumentumban nem blokkolja a többi írást.
    function chg(f) { return f in request.resource.data && (!(f in resource.data) || request.resource.data[f] != resource.data[f]); }
    function scoreOk(f, lower, maxV) { let n = request.resource.data; let o = resource.data; return !chg(f) || (n[f] is number && n[f] > 0 && n[f] <= maxV && (!(f in o) || n[f] == o[f] || (lower ? n[f] < o[f] : n[f] > o[f]))); }
    function cntOk(f) { let n = request.resource.data; let o = resource.data; return !chg(f) || (n[f] is int && (n[f] == o.get(f, 0) + 1 || n[f] == o.get(f, 0))); }
    // SZERVERIDŐ: a telefon órája/naptára nem számít. A hónapot a szerver órája adja magyar idő szerint (UTC+1 télen, UTC+2 nyáron).
    function mk(t) { return string(t.year()) + '-' + (t.month() < 10 ? '0' : '') + string(t.month()); }
    function curMonths() { return [mk(request.time + duration.value(1, 'h')), mk(request.time + duration.value(2, 'h'))]; }
    function nowMs() { return request.time.toMillis(); }
    // Tüzér Kassza befizetés: csak nőhet, és csak a valós (szerver)idővel arányosan – az utolsó befizetés óta eltelt
    // másodpercenként legfeljebb a meglévő összeg 2%-a (de legalább 10 millió Ft), +2 perc ráhagyás. Kitalált óriásszám nem kerülhet fel.
    function tkFtOk() { let n = request.resource.data; let o = resource.data; let ft0 = o.get('tkFt', 0); let rate = ft0 * 0.02 > 10000000 ? ft0 * 0.02 : 10000000;
      return !chg('tkFt') || (n.tkFt is number && n.tkFt >= ft0 && n.tkFt <= math.pow(10.0, 30) && n.get('tkSt', null) == request.time
        && ('tkSt' in o ? n.tkFt - ft0 <= ((request.time - o.tkSt).seconds() + 120) * rate : (ft0 > 0 || n.tkFt <= 1000000000000))); }
    // a szerveridő-bélyeg csak a mostani szerveridő lehet, és nem törölhető
    function tkStOk() { return (!chg('tkSt') || request.resource.data.tkSt == request.time) && (!('tkSt' in resource.data) || 'tkSt' in request.resource.data); }
    // havi összeg: csak a szerver szerinti aktuális hónapra, és csak annyival nőhet, amennyivel ugyanebben a mentésben a befizetés nőtt
    function tkWgOk() { let n = request.resource.data; let o = resource.data; let base = n.get('tkWk', '') == o.get('tkWk', '') ? o.get('tkWg', 0) : 0;
      return (!chg('tkWk') && !chg('tkWg')) || (n.tkWk is string && n.tkWk in curMonths() && n.tkWg is number && n.tkWg >= base
        && n.tkWg - base <= (n.get('tkFt', 0) - o.get('tkFt', 0)) * 1.000001 + 1); }
    function tkOk() { let n = request.resource.data; let o = resource.data; return (!chg('tkGive') || (n.tkGive is number && n.tkGive >= 0 && n.tkGive >= o.get('tkGive', 0))) && tkFtOk() && tkStOk() && tkWgOk() && (!chg('tkUteg') || n.tkUteg in ['1. üteg', '2. üteg', '3. üteg', 'Kiképző üteg', 'Törzsüteg', 'Felderítő', 'Szakjavító']); }
    // időbélyeg: szám, és nem lehet a szerver szerinti jövőben (5 perc ráhagyás) – a telefon naptárának előreállítása nem segít
    function tsOk(f) { return !chg(f) || (request.resource.data[f] is number && request.resource.data[f] <= nowMs() + 300000); }
    // a Kassza mentés ideje: a szerver mostani idejéhez közeli (−1 óra … +5 perc)
    function tkAtOk() { return !chg('tkAt') || (request.resource.data.tkAt is number && request.resource.data.tkAt <= nowMs() + 300000 && request.resource.data.tkAt >= nowMs() - 3600000); }
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid && request.resource.data.keys().hasOnly(['name', 'rank', 'nick', 'createdAt']) && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 20 && request.resource.data.rank is string && request.resource.data.rank.size() <= 24 && request.resource.data.nick == request.auth.token.email.split('@')[0] && request.resource.data.createdAt is number && request.resource.data.createdAt <= nowMs() + 300000;
      allow update: if signedIn() && request.auth.uid == uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rank', 'harcBest', 'harcAt', 'droneBest', 'droneAt', 'gtBest', 'gtBestAt', 'gkBest', 'gkBestAt', 'rkBest', 'rkBestAt', 'rkhBest', 'rkhBestAt', 'sereBest', 'sereBestAt', 'harcN', 'droneN', 'gtN', 'gkN', 'rkN', 'sereN', 'tkN', 'tkGive', 'tkUteg', 'tkAt', 'tkOwn', 'tkFt', 'tkOwnF', 'tkWk', 'tkWg', 'tkSt', 'lastPlay']) && request.resource.data.get('rank', '') is string && request.resource.data.get('rank', '').size() <= 24 && scoreOk('harcBest', false, 100000) && scoreOk('droneBest', false, 100000000) && scoreOk('gtBest', true, 3600000) && scoreOk('gkBest', false, 100000000) && scoreOk('rkBest', false, 100000) && scoreOk('rkhBest', false, 1000000000000) && tsOk('rkhBestAt') && scoreOk('sereBest', false, 10000000000) && tsOk('sereBestAt') && tsOk('harcAt') && tsOk('droneAt') && tsOk('gtBestAt') && tsOk('gkBestAt') && tsOk('rkBestAt') && tsOk('lastPlay') && cntOk('harcN') && cntOk('droneN') && cntOk('gtN') && cntOk('gkN') && cntOk('rkN') && cntOk('sereN') && cntOk('tkN') && tkOk() && tkAtOk() && (!chg('tkOwn') || (request.resource.data.tkOwn is map && request.resource.data.tkOwn.size() <= 40)) && (!chg('tkOwnF') || (request.resource.data.tkOwnF is map && request.resource.data.tkOwnF.size() <= 40));
      allow update, delete: if isAdmin();
    }
    match /chat/{msgId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['uid', 'name', 'rank', 'text', 'ts']) && request.resource.data.uid == request.auth.uid && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 300 && request.resource.data.name == me().name && request.resource.data.rank == me().get('rank', '') && request.resource.data.ts is number && request.resource.data.ts <= request.time.toMillis() + 60000 && request.resource.data.ts > request.time.toMillis() - 86400000;
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
    }
    // havi lezárás: minden játékos a saját előző havi összegét írja (egyszer), mindenki olvashatja
    match /tkRes/{rid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['m', 'uid', 'name', 'uteg', 'g', 'ts']) && request.resource.data.uid == request.auth.uid && rid == request.resource.data.m + '_' + request.auth.uid && request.resource.data.m is string && request.resource.data.m.matches('[0-9]{4}-[0-9]{2}') && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 20 && request.resource.data.uteg in ['1. üteg', '2. üteg', '3. üteg', 'Kiképző üteg', 'Törzsüteg', 'Felderítő', 'Szakjavító'] && request.resource.data.g is number && request.resource.data.g >= 0 && request.resource.data.ts is number && request.resource.data.ts <= nowMs() + 300000
        // csak lezárult (szerver szerint elmúlt) hónap, és csak a ranglistán ténylegesen álló havi összeg
        && request.resource.data.m < mk(request.time + duration.value(2, 'h')) && me().get('tkWk', '') == request.resource.data.m && request.resource.data.g <= me().get('tkWg', 0) + 1;
      allow update, delete: if false;
    }
    // Shot&Run párbajszoba: a házigazda nyitja (5 jegyű kód), egy vendég csatlakozhat, utána csak ők ketten írhatják az eseményt
    match /srRooms/{code} {
      allow read: if signedIn();
      allow create: if signedIn() && code.matches('[A-Z0-9]{5}') && request.resource.data.keys().hasOnly(['host', 'hostName', 'guest', 'guestName', 'seed', 'ev', 'ts']) && request.resource.data.ts is number && request.resource.data.ts <= request.time.toMillis() + 300000 && request.resource.data.host == request.auth.uid && request.resource.data.guest == null && request.resource.data.hostName is string && request.resource.data.hostName.size() <= 24 && request.resource.data.guestName == '' && request.resource.data.seed is int && request.resource.data.ev == '' && request.resource.data.ts is number;
      allow update: if signedIn() && request.resource.data.ts is number && ((resource.data.guest == null && resource.data.host != request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['guest', 'guestName', 'ts']) && request.resource.data.guest == request.auth.uid && request.resource.data.guestName is string && request.resource.data.guestName.size() <= 24) || ((resource.data.host == request.auth.uid || resource.data.guest == request.auth.uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ev', 'ts']) && request.resource.data.ev is string && request.resource.data.ev.size() <= 30000));
      allow delete: if signedIn() && (resource.data.host == request.auth.uid || isAdmin());
    }
    match /{document=**} { allow read, write: if false; }
  }
}
